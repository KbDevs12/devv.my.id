---
import { Icon } from "astro-icon/components";

import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Badge from "../components/Badge.astro";
import JsonResponse from "../components/JsonResponse.astro";
import { reorderObject } from "../utils/re-arrage";

import {
  iconMap,
  type ExperienceProp,
  type ProjectProp,
} from "../types/global";

const [profileRes, techStackRes, experienceRes, ProjectRes] = await Promise.all(
  [
    fetch("https://portofolio-cms-tau.vercel.app/api/profile"),
    fetch("https://portofolio-cms-tau.vercel.app/api/tech_stack"),
    fetch("https://portofolio-cms-tau.vercel.app/api/experience"),
    fetch("https://portofolio-cms-tau.vercel.app/api/projects"),
  ],
);

const profile = await profileRes.json();
const techStack = await techStackRes.json();
const experiences = await experienceRes.json();
const projects = await ProjectRes.json();
const profileData = profile.data;
const stackData = techStack.data;
const experienceData: ExperienceProp[] = experiences.data;
const projectsData: ProjectProp[] = projects.data;

const stacks = stackData.uniqueTechStack;

const projectsView = projectsData.map((project) => ({
  ...project,
  aspects: project.project_aspects.map((aspect) =>
    reorderObject(aspect, [
      "aspect_title",
      "description",
      "tech_stack",
      "repo_url",
    ]),
  ),
}));
---

<Layout title="Aditya Putra">
  <Sidebar />

  <main class="md:ml-72 min-h-screen flex flex-col">
    <section id="overview" data-reveal-stagger class="mx-auto px-6 py-10">
      <div class="max-w-4xl flex-col gap-4 sm:gap-5 md:gap-6">
        <h1
          class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl sm:leading-[1.05] md:text-5xl lg:text-6xl"
        >
          {profileData.headline}
        </h1>
      </div>

      <div aria-label="contact-icon" class="flex mt-20 gap-4">
        <a
          href={`mailto:${profileData.email}`}
          class="inline-flex items-center gap-2 rounded border border-line px-3 py-1.5 font-mono text-xs hover:border-ink"
        >
          <Icon name="lucide:mail" class="size-4" />
          email
        </a>
        <a
          href={profileData.github_url}
          class="inline-flex items-center gap-2 rounded border border-line px-3 py-1.5 font-mono text-xs hover:border-ink"
        >
          <Icon name="simple-icons:github" class="size-4" />
          Github
        </a>
      </div>
    </section>

    <div
      class="marquee-fade mx-auto w-full overflow-hidden border-y border-line bg-panel py-3 md:w-3xl"
    >
      <div
        class="flex w-max animate-marquee font-mono text-sm text-muted will-change-transform motion-reduce:animate-none"
      >
        {
          [0, 1].map((i) => (
            <ul
              aria-hidden={i === 1 ? "true" : undefined}
              class="flex shrink-0 items-center gap-10 pr-10"
            >
              {[...stacks, ...stacks].map((item) => (
                <li class="flex shrink-0 items-center gap-2">
                  <Icon
                    name={iconMap[item] ?? "lucide:code-2"}
                    class="size-4"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>

    <section class="mx-auto w-full max-w-4xl px-6 py-16">
      <div data-reveal-stagger class="flex flex-col gap-5">
        <p class="mb-2 font-mono text-sm text-muted">/ profile</p>

        <div class="overflow-hidden rounded-lg border border-line bg-panel">
          <div class="flex items-center gap-2 border-b border-line px-4 py-3">
            <span class="size-2.5 rounded-full bg-red-400"></span>
            <span class="size-2.5 rounded-full bg-yellow-400"></span>
            <span class="size-2.5 rounded-full bg-green-500"></span>

            <span class="ml-2 font-mono text-xs text-muted">
              aditya@portfolio:~
            </span>
          </div>

          <div
            class="space-y-5 p-5 font-mono text-xs leading-7 sm:p-6 sm:text-sm"
          >
            <div>
              <p class="text-muted">
                <span class="text-teal">$</span> whoami
              </p>

              <p class="mt-1 text-ink">
                {profileData.full_name}
              </p>

              <p class="text-muted">
                {profileData.headline}
              </p>
            </div>

            <div>
              <p class="text-muted">
                <span class="text-teal">$</span> cat bio.txt
              </p>

              <p class="mt-1 max-w-3xl text-muted">
                {profileData.bio}
              </p>
            </div>

            <div class="text-muted">
              <span class="text-teal">$</span>
              <span class="ml-1 animate-pulse">_</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-line border w-full"></div>
    <section
      id="experience"
      class="my-24 flex w-full max-w-4xl flex-col px-6 md:my-32 md:ml-64 md:px-0"
    >
      <p data-reveal class="mb-8 font-mono text-sm text-muted md:mb-10">
        / experience
      </p>

      <div data-reveal-stagger class="space-y-6">
        {
          experienceData &&
            experienceData.map((exp, index) => (
              <div
                id={`${index}`}
                class:list={[
                  "border-l-2 py-2 pl-4 md:pl-6",
                  {
                    "border-teal": exp.is_current,
                    "border-line": !exp.is_current,
                  },
                ]}
              >
                <p class="font-mono text-xs text-muted">
                  {exp.start_date} -{" "}
                  {exp.is_current ? "Sekarang" : exp.end_date}
                </p>

                <p class="mt-1 font-medium text-xl">
                  {exp.job_title}, {exp.company_name}
                </p>

                <p class="mt-1 max-w-lg text-sm leading-relaxed tracking-wide text-muted">
                  {exp.description}
                </p>
              </div>
            ))
        }
      </div>
    </section>

    <div class="border-line border w-full"></div>

    <section
      id="projects"
      data-hscroll
      class="w-full max-w-4xl md:ml-64 hscroll:ml-0 hscroll:max-w-none"
    >
      <div
        data-hscroll-pin
        class="flex flex-col gap-4 px-4 py-16 md:px-0 md:py-32 hscroll:h-dvh hscroll:justify-center hscroll:gap-8 hscroll:py-0"
      >
        <div
          data-reveal
          class="flex items-center justify-between gap-6 hscroll:px-12"
        >
          <p class="font-mono text-sm text-muted">/ projects</p>

          <div
            aria-hidden="true"
            class="hidden h-px w-40 bg-line hscroll:block"
          >
            <div data-hscroll-progress class="h-full w-full bg-teal"></div>
          </div>
        </div>

        <div data-hscroll-viewport class="hscroll:overflow-x-clip">
          <div
            data-hscroll-track
            class="flex flex-col gap-6 hscroll:w-max hscroll:flex-row hscroll:gap-6 hscroll:px-12"
          >
            {
              projectsView.map((p) => (
                <article
                  data-reveal
                  data-hscroll-panel
                  class="sm:rounded-lg sm:border sm:border-line sm:p-5 hscroll:w-[clamp(28rem,50vw,42rem)] hscroll:shrink-0"
                >
                  <code class="flex items-center gap-2 font-mono text-sm font-medium text-teal">
                    <Badge status="GET" />/{p.slug}
                  </code>

                  <p class="px-2 py-3 text-sm leading-relaxed text-muted sm:py-4">
                    {p.summary}
                  </p>

                  <JsonResponse
                    data={p.aspects}
                    status={200}
                    bodyClass="hscroll:max-h-[min(32rem,calc(100dvh-22rem))]"
                  />
                </article>
              ))
            }

            <article
              data-reveal
              data-hscroll-panel
              class="flex flex-col justify-center sm:rounded-lg sm:border sm:border-line sm:p-5 hscroll:w-[clamp(28rem,50vw,42rem)] hscroll:shrink-0"
            >
              <div class="text-center">
                <p class="font-mono text-2xl font-semibold text-ink">
                  Coming Soon
                </p>

                <p class="mt-2 text-sm text-muted">
                  Something new is being built.
                </p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <div class="border-line border w-full"></div>

    <section id="contact" class="px-4 py-10 md:px-12 md:py-16">
      <p data-reveal class="mb-6 font-mono text-sm text-muted">/ contact</p>

      <div data-reveal class="overflow-hidden rounded-lg border border-line">
        <div
          class="flex items-center gap-2 border-b border-line bg-panel px-4 py-3 md:px-5"
        >
          <Badge status="POST" />
          <code class="font-mono text-sm">/contact</code>
        </div>

        <div class="grid md:grid-cols-2">
          <form
            data-contact-form
            class="flex flex-col gap-4 border-b border-line p-4 md:border-b-0 md:border-r md:p-5"
          >
            <p class="font-mono text-xs text-muted">Request body</p>

            <label class="flex flex-col gap-1.5">
              <span class="font-mono text-xs text-muted">
                name <span class="text-teal">string</span>
              </span>

              <input
                name="name"
                type="text"
                required
                placeholder="Your name"
                class="w-full rounded border border-line bg-transparent px-3 py-2.5 text-sm outline-none transition-colors focus:border-teal"
              />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="font-mono text-xs text-muted">
                email <span class="text-teal">string</span>
              </span>

              <input
                name="email"
                type="email"
                required
                placeholder="your@email.com"
                class="w-full rounded border border-line bg-transparent px-3 py-2.5 text-sm outline-none transition-colors focus:border-teal"
              />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="font-mono text-xs text-muted">
                message <span class="text-teal">string</span>
              </span>

              <textarea
                name="message"
                required
                rows="4"
                placeholder="There is a suitable project or position?"
                class="w-full resize-none rounded border border-line bg-transparent px-3 py-2.5 text-sm outline-none transition-colors focus:border-teal"
              ></textarea>
            </label>

            <button
              type="submit"
              data-submit-btn
              class="mt-1 inline-flex w-full items-center justify-center gap-2 rounded bg-teal px-4 py-2.5 font-mono text-xs font-medium text-paper transition-opacity disabled:opacity-60 md:w-fit"
            >
              Send request
            </button>
          </form>

          <div class="flex flex-col p-4 md:p-5">
            <p class="mb-2 font-mono text-xs text-muted">Body</p>

            <pre
              data-body-preview
              class="overflow-x-auto rounded bg-panel p-4 font-mono text-xs leading-relaxed text-muted">{`{\n  "name": "",\n  "email": "",\n  "message": ""\n}`}</pre>

            <div class="mt-5 flex items-center gap-2">
              <p class="font-mono text-xs text-muted">Response</p>

              <span
                data-status-badge
                class="hidden rounded px-2 py-0.5 font-mono text-[10px] font-medium text-teal"
              ></span>
            </div>

            <pre
              data-response-preview
              class="mt-2 min-h-24 overflow-x-auto rounded bg-panel p-4 font-mono text-xs leading-relaxed text-muted">// response will appear here after the request is sent.</pre>
          </div>
        </div>
      </div>
    </section>

    <script>
      function setup() {
        const form = document.querySelector<HTMLFormElement>(
          "[data-contact-form]",
        );
        if (!form || form.dataset.bound) return;
        form.dataset.bound = "true";

        const bodyPreview = document.querySelector<HTMLPreElement>(
          "[data-body-preview]",
        );
        const responsePreview = document.querySelector<HTMLPreElement>(
          "[data-response-preview]",
        );
        const statusBadge = document.querySelector<HTMLSpanElement>(
          "[data-status-badge]",
        );
        const submitBtn =
          form.querySelector<HTMLButtonElement>("[data-submit-btn]");

        const fields = ["name", "email", "message"] as const;

        function getField(name: (typeof fields)[number]) {
          return form!.querySelector<HTMLInputElement | HTMLTextAreaElement>(
            `[name="${name}"]`,
          );
        }

        function updatePreview() {
          const data = Object.fromEntries(
            fields.map((f) => [f, getField(f)?.value ?? ""]),
          );
          if (bodyPreview)
            bodyPreview.textContent = JSON.stringify(data, null, 2);
        }

        fields.forEach((f) => {
          getField(f)?.addEventListener("input", updatePreview);
        });

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (!submitBtn) return;

          submitBtn.disabled = true;
          submitBtn.textContent = "Sending...";
          statusBadge?.classList.add("hidden");

          await new Promise((r) => setTimeout(r, 900));

          const name = getField("name")?.value ?? "";

          if (responsePreview) {
            responsePreview.textContent = JSON.stringify(
              {
                status: "received",
                message: `Thanks, ${name || "there"}! I'll get back to you soon.`,
              },
              null,
              2,
            );
          }

          if (statusBadge) {
            statusBadge.textContent = "200 OK";
            statusBadge.classList.remove("hidden");
            statusBadge.classList.add("bg-teal-tag");
          }

          submitBtn.disabled = false;
          submitBtn.textContent = "Send request";
          form.reset();
          updatePreview();
        });
      }

      setup();
      document.addEventListener("astro:after-swap", setup);
    </script>
  </main>
</Layout>
